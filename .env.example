# Skopiuj ten plik jako .env i wpisz swoje klucze API.
# Nie musisz mieć wszystkich - dostawca bez klucza jest po prostu pomijany.
# Plik .env jest w .gitignore - NIGDY go nie commituj.

# Google Gemini (AI Studio)  -> https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Mistral                     -> https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Ollama Cloud                -> https://ollama.com/settings/keys
OLLAMA_API_KEY=

# Groq                        -> https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter (skanowane tylko modele :free) -> https://openrouter.ai/keys
OPENROUTER_API_KEY=

# NVIDIA NIM                  -> https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=

# OpenAI (płatne API; skaner wysyła minimalne zapytania) -> https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Cloudflare Workers AI       -> https://dash.cloudflare.com/profile/api-tokens
# Account ID znajdziesz w panelu Cloudflare (Workers AI / prawa kolumna na stronie głównej konta).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Tylko jeśli generujesz config LiteLLM (podstaw swoje ACCOUNT_ID):
# CLOUDFLARE_AI_BASE=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1

# Opcjonalnie: własny serwer Ollama, do którego ma się łączyć LiteLLM (tylko w wygenerowanym configu)
# OLLAMA_API_BASE=http://localhost:11434
